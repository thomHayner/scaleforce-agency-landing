# Contentful — required for build (blog/landing page content).
CONTENTFUL_SPACE_ID=
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=

# Airtable — legacy integration (see src/lib/astro-airtable/). Not wired into the default build.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Contact form — required at runtime for the /api/contact serverless function.
# Resend API key (https://resend.com/api-keys).
RESEND_API_KEY=
# Destination inbox for new contact submissions.
CONTACT_TO_EMAIL=
# Verified sender on Resend (must match a verified domain/address).
CONTACT_FROM_EMAIL=
